// What this is: the PRODUCTION wrangler configuration for the `identity-admin`
// Worker — the administrative BFF and operator session.
//
// What this is NOT: it is not a working config on its own (every id is a
// PLACEHOLDER, see the secrets note in
// infra/cloudflare/production/identity.wrangler.jsonc), and it has no D1
// binding. Read the boundary note below before editing.
//
// =================================================================================
// SECRETS (brief §2 constraint 27). Placeholders are injected at deploy time by
// .github/workflows/deploy-production.yml into a generated copy of this file
// that is never committed. A service name and a rate-limit namespace id are
// treated as secrets here for the same reason a D1 id is: naming the thing an
// attacker must reach is the first half of reaching it.
// =================================================================================

{
  "$schema": "../../../../node_modules/wrangler/config-schema.json",

  "name": "identity-admin",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  "main": "build/index.js",
  "build": {
    "command": "cd ../../../../apps/identity-admin/worker && cargo install -q \"worker-build@^0.8\" --locked && worker-build --release",
  },

  // `redact_query_string` matters here for a different reason than on
  // `identity`: the admin console carries the operator's own session in the
  // URL on some navigation paths, and an operator session is a full
  // administrative credential. The OAuth `code`/`state`/`nonce` argument
  // applies too — the admin BFF terminates an OIDC flow of its own.
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "persist": true,
    },
    "issues": {
      "enabled": true,
    },
  },

  "services": [
    {
      // PLACEHOLDER — injected at deploy time. This is the ONLY path from the
      // admin console to identity data. brief §2 constraint 4 requires a
      // private service binding precisely so that "the admin Worker can read
      // identity" is a property of this one line and not of a credential
      // someone might find in an environment variable.
      "binding": "IDENTITY",
      "service": "PRODUCTION_IDENTITY_WORKER",
    },
  ],

  "ratelimits": [
    {
      "name": "ADMIN_RATE_LIMITER",
      // PLACEHOLDER — injected at deploy time. Separate from the identity
      // limiter so a burst of operator automation (a bulk rehash, a session
      // sweep) cannot consume the end-user login budget.
      "namespace_id": "PRODUCTION_ADMIN_RATE_LIMITER_NAMESPACE_ID",
      "simple": {
        // Higher than the user-facing limiter: the console does bursts by
        // design, and an operator locked out mid-incident is a worse outcome
        // than a slightly over-permissive console rate limit. The limit that
        // actually protects an admin account is MFA + the identity Worker,
        // not this number.
        "limit": 600,
        "period": 60,
      },
    },
  ],

  "assets": {
    // brief §8: the frontend and the BFF behind it are ONE release unit. The
    // console's `dist/` is built by `identity-admin-web:build` in the same
    // commit that produced this Worker's bundle and is uploaded as its
    // static assets. There is no separate CDN origin and no separate version:
    // a console older than its BFF is not a supportable state.
    "directory": "../../../../apps/identity-admin/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
  },

  // Smart placement, unlike `identity`. The admin console is a small number of
  // known operators whose sessions are checked on every request, but its
  // traffic volume is negligible and its latency is felt directly by a human
  // clicking through a console during an incident. Both arguments point the
  // same way: put the Worker near the operator and near the admin database.
  "placement": {
    "mode": "smart",
  },

  "vars": {
    "ENVIRONMENT": "production",
  },

  // ---------------------------------------------------------------------------------
  // BOUNDARY: there is no `d1_databases` block in this file, and adding one is
  // not a configuration change. brief §2 constraint 3 — "The Admin Worker MUST
  // NOT access Identity D1 directly" — and constraint 29 makes that a
  // constraint that an ADR must relax before any code lands, let alone before a
  // binding appears here. The absence is recorded in this comment so the next
  // editor knows the file is complete, not unfinished.
  //
  // It is worth being precise about what a D1 binding here would actually buy,
  // because the argument "the admin Worker is on the same account, so why not"
  // is the usual one and it is wrong in a specific way: with a binding, the
  // admin Worker could apply writes to identity tables without going through
  // a single application-layer rule. Every invariant in identity-domain —
  // the ones named in crates/identity-domain/src/invariants.rs — lives above
  // D1. A D1 binding does not bypass the rules; it bypasses the layer that
  // enforces them, which is the same outcome with a much smaller diff.
  //
  // The `identity-admin` database (console's own state: operator preferences,
  // audit view configuration) is a separate concern and is DEFERRED to the
  // administration phase; `identity-cloudflare`'s admin-database adapter is
  // where it lands when it does.
  // ---------------------------------------------------------------------------------
}
