// What this is: the DEVELOPMENT (local) wrangler configuration for the
// `identity-jobs` Worker — the queue consumer for email delivery, security
// notifications and audit archival.
//
// What this is NOT: it is not a staging or production configuration, and it
// owns no identity state and therefore has no database binding at all.
//
// Read with:  wrangler dev -c infra/cloudflare/development/identity-jobs.wrangler.jsonc
// From a contributor: `moon run identity-jobs:dev`.
//
// ---------------------------------------------------------------------------------
// BOUNDARY: no `d1_databases` block, and none may be added. brief §2 constraint 5
// — "The Jobs Worker is a background side-effect worker and owns NO identity
// state." It also does not get its own database: jobs records the fact that it
// did something (idempotency keys, dead-letter state) and that is KV, below.
// A second database for jobs would be a second place to enforce a rule and a
// second thing to migrate under brief §2 constraint 21.
//
// The same rule is stated in Cargo.toml: this crate does not depend on
// `identity-domain` or `identity-application`, so it cannot evaluate an identity
// rule even if someone hands it a payload that asks it to. `tooling/scripts/
// check-architecture.mjs` enforces that from `cargo metadata`.
// ---------------------------------------------------------------------------------

{
  "$schema": "../../../../node_modules/wrangler/config-schema.json",

  "name": "identity-jobs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // See infra/cloudflare/development/identity/wrangler.jsonc for why `main`
  // points at the worker-build JS shim rather than at src/lib.rs.
  "main": "build/index.js",
  "build": {
    // ------------------------------------------------------------------------
    // THE COMMAND LOCATES THE REPOSITORY ROOT ITSELF. There is no `cwd` key
    // here, and both halves of that are deliberate.
    //
    // WHY NO `cwd`. Measured against wrangler 4.144.0, invoked from the
    // repository root with `-c infra/cloudflare/staging/identity/wrangler.jsonc`,
    // this is where a custom build actually runs for each spelling of `cwd`:
    //
    //   build.cwd      where the build ran
    //   ------------   ------------------------------------------------------
    //   (absent)       the INVOKING PROCESS's working directory
    //   "."            the invoking process's working directory — identical
    //   "../.."        the invoking process's working directory, plus ".."
    //   "$PWD"         Error: spawn /bin/sh ENOENT — `cwd` goes to spawn()
    //                  unexpanded, so a shell token makes wrangler try to
    //                  spawn the literal string as a directory
    //   "/abs/path"    exactly that path
    //
    // So `cwd` has no spelling that is both portable and caller-independent:
    // the relative ones are relative to whoever ran wrangler, and the absolute
    // one would hard-code `/home/<user>/…` into nine tracked configs that a
    // fork, a CI runner or a second contributor cannot use.
    //
    // WHY THE COMMAND THEN DOES THE LOCATING. `command -v wrangler` resolves
    // through node_modules to `<repo>/node_modules/.bin/wrangler`, so three
    // `dirname`s from it is the repository root — wherever the repository is,
    // whoever cloned it, and whichever directory wrangler was invoked from.
    //
    // THAT THIS WAS THE BUG. The command used to be
    //
    //   cd ../../../../apps/identity/worker && … --out-dir ../../../…
    //
    // with four `..` written for "the config's own directory". Every LOCAL
    // command and the `wrangler-validate` moon task do `cd` there first, so
    // four was right for them and the build worked on a laptop.
    // `deploy-worker.yml` does not: it runs wrangler from the REPOSITORY ROOT
    // against `-c infra/cloudflare/<env>/<worker>/wrangler.generated.jsonc`,
    // and four `..` from there leaves the repository entirely. The first
    // staging deploy failed with
    //
    //   [custom build] /bin/sh: 1: cd: can't cd to ../../../../apps/identity/worker
    //
    // — one level short, which is exactly what four levels up from the
    // repository root is. A custom build whose working directory depends on
    // who invoked wrangler is not a build; it is a build that happens to work
    // for the callers somebody happened to try first.
    //
    // `--out-dir` stays explicit because `worker-build` defaults it to `build`
    // relative to ITS OWN working directory — the crate — so the default writes
    // to `apps/<w>/worker/build/` while wrangler looks in
    // `infra/cloudflare/<env>/<w>/build/`, and reports "The expected output file
    // at build/index.js was not found", naming the path it could not find
    // rather than the one that was written.
    //
    // Verified from two different caller directories — the repository root and
    // the config's own — both of which land the build in `apps/<w>/worker` and
    // put the artefact where `main` points.
    // ------------------------------------------------------------------------
    "command": "ROOT=$(dirname \"$(dirname \"$(dirname \"$(command -v wrangler)\")\")\") && cd \"$ROOT/apps/identity-jobs/worker\" && cargo install -q \"worker-build@^0.8\" --locked && worker-build --release --out-dir \"$ROOT/infra/cloudflare/development/identity-jobs/build\"",
  },

  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": false,
    },
  },

  "services": [
    {
      // The narrow internal endpoints jobs needs — e.g. re-reading a user
      // record to address an email. Deliberately narrow: a service binding to
      // the whole identity Worker exposes its entire route table, so the
      // internal surface is kept small on the identity side, and jobs only
      // calls the endpoints it needs.
      "binding": "IDENTITY",
      "service": "identity-development",
    },
    {
      // brief §3 marks this binding "deferred". It is declared in every
      // environment so the code path is uniform; the DEFERRED part is the
      // provider implementation, not the binding.
      "binding": "EMAIL_PROVIDER",
      "service": "identity-email-provider-development",
    },
  ],

  "kv_namespaces": [
    {
      // Scratch space and idempotency keys: "have I already sent this
      // verification email?". brief §2 constraint 24 — never authoritative
      // identity state. If a key is lost the consequence is a duplicate email,
      // not a wrong authorization decision.
      //
      // Local KV is a local directory keyed by name, so this id is never
      // resolved against the account — but it still has to be a NON-EMPTY
      // string, because `"id": ""` makes `wrangler deploy --dry-run` fail
      // config validation. Zero-shaped and suffixed `b` to match the
      // convention the other environments use for this Worker.
      "binding": "JOBS_KV",
      "id": "0000000000000000000000000000000b",
      "remote": false,
    },
  ],

  "queues": {
    "consumers": [
      {
        // Same queue name as the producer binding in identity/wrangler.jsonc.
        // brief §2 constraint 22: producer and consumer are backward-compatible
        // with each other, which is a property of the event envelope in
        // contracts/events/v1/ — not something this file can enforce.
        "queue": "identity-development",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        // Retries here, not in the Worker code: a transient SMTP failure must
        // not require a redeploy to recover from.
        "max_retries": 5,
        // A message that fails 5 times is parked rather than dropped. Dropping
        // a security notification silently is worse than parking it.
        "dead_letter_queue": "identity-development-dlq",
      },
    ],
  },

  "vars": {
    // Non-secret configuration only; secrets come from `.dev.vars` (gitignored).
    "ENVIRONMENT": "development",
  },
}
