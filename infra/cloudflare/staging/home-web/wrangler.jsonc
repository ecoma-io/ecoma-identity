// Staging wrangler configuration for home-web.
//
// The staging script name prevents an upload from replacing production. Nuxt's
// Worker module and Workers Assets stay relative to this config. No stateful or
// Identity binding belongs to this public deployable (ADR-0016).

{
  "name": "home-web-staging",
  "main": "../../../../apps/home-web/.output/server/index.mjs",
  "compatibility_date": "2024-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "../../../../apps/home-web/.output/public",
  },
}
