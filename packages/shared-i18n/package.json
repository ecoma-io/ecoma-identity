{
  "name": "@ecoma-io/shared-i18n",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared i18n utilities and types for Ecoma frontend applications.",
  "license": "Apache-2.0",
  "repository": {
